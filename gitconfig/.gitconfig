[user]
	name = Arthur Albuquerque
	email = 20231694+troclaux@users.noreply.github.com
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
	default = simple
	followTags = true
[commit]
	verbose = true
[help]
	autocorrect = prompt
[rerere]
	enabled = true
	autoupdate = true
[core]
	whitespace = trailing-space
	editor = nvim
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	# n and N jump between files in the pager
	navigate = true
[column]
	ui = auto
[branch]
	sort = -committerdate
[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true
